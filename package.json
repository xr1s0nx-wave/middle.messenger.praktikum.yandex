{
  "name": "messanger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "vite build && vite preview",
    "prettier": "prettier --write .",
    "lint": "tsc --noEmit && eslint . --ext .ts,.tsx,.js && stylelint \"**/*.scss\"",
    "prepare": "husky install",
    "test": "mocha -r ts-node/register --extension ts \"src/**/*.test.ts\""
  },
  "lint-staged": {
    "src/**/*.{ts,js,tsx,jsx}": [
      "eslint --fix"
    ],
    "src/**/*.{scss,css}": [
      "stylelint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "chai": "^5.2.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "handlebars": "^4.7.8",
    "husky": "^8.0.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.89.2",
    "stylelint": "^16.21.1",
    "stylelint-config-standard": "^38.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.5"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "dependencies": {
    "uuid": "^11.1.0"
  }
}
