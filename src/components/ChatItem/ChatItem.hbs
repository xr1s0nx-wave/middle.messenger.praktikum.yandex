<div class="chats__item-avatar">
  {{#if avatarUrl}}
    <img src="{{avatarUrl}}" alt="Аватар" />
  {{else}}
    <div class="chats__dialogue-avatar--stub"></div>
  {{/if}}
</div>
<div class="chats__item-info">
  {{#if isActive}}
    <span class="chats__item-unread">active</span>
  {{/if}}
  <h3 class="chats__item-name">{{title}}</h3>
  <p class="chats__item-message">
    {{#if lastMessageIsMine}}
      <span class="chats__item-message--mine">Вы: </span>
    {{/if}}
    {{lastMessage}}
  </p>
</div>